# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGINS=https://juliancavallo.github.io
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_or_anon_key
# Used only by the backend to persist the holiday cache. Never expose it in GitHub Pages.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Adds http://localhost to the allowed origins for local testing.
DEVELOPMENT=false
